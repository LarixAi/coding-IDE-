{
  "name": "CodeMe Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#1ed1cd",
    "foreground": "#e1e5ea",
    "editor.background": "#171b23",
    "editor.foreground": "#dfe4ec",
    "editorCursor.foreground": "#7fd3ea",
    "editor.lineHighlightBackground": "#1d222c",
    "editorGutter.background": "#171b23",
    "minimap.background": "#171b23",
    "editorLineNumber.foreground": "#8c939b",
    "editorLineNumber.activeForeground": "#e1e5ea",
    "editor.selectionBackground": "#162d3288",
    "editorWidget.background": "#0f1319",
    "editorWidget.border": "#2a2e35",
    "sideBar.background": "#0f1319",
    "sideBar.foreground": "#d3d8de",
    "sideBar.border": "#23272d",
    "sideBarTitle.foreground": "#e1e5ea",
    "activityBar.background": "#090c11",
    "activityBar.foreground": "#7fd3ea",
    "activityBar.activeBorder": "#7fd3ea",
    "activityBar.activeBackground": "#2b3a48",
    "activityBarBadge.background": "#7fd3ea",
    "activityBarBadge.foreground": "#171b23",
    "activityBar.inactiveForeground": "#999fa6",
    "activityBar.border": "#23272d",
    "titleBar.activeBackground": "#090c11",
    "titleBar.activeForeground": "#e1e5ea",
    "titleBar.inactiveBackground": "#090c11",
    "titleBar.inactiveForeground": "#999fa6",
    "titleBar.border": "#23272d",
    "statusBar.background": "#090c11",
    "statusBar.foreground": "#999fa6",
    "statusBar.border": "#23272d",
    "statusBar.noFolderBackground": "#090c11",
    "panel.background": "#0f1319",
    "panel.border": "#23272d",
    "panelTitle.activeForeground": "#e1e5ea",
    "panelTitle.inactiveForeground": "#8c939b",
    "tab.activeBackground": "#13161c",
    "tab.activeForeground": "#e1e5ea",
    "tab.inactiveBackground": "#0f1319",
    "tab.inactiveForeground": "#8c939b",
    "tab.border": "#23272d",
    "editorGroupHeader.tabsBackground": "#0f1319",
    "list.activeSelectionBackground": "#162d32",
    "list.activeSelectionForeground": "#e1e5ea",
    "list.hoverBackground": "#1c2128",
    "list.inactiveSelectionBackground": "#192f35",
    "input.background": "#20242b",
    "input.foreground": "#e1e5ea",
    "input.border": "#2a2e35",
    "button.background": "#1ed1cd",
    "button.foreground": "#001218",
    "button.hoverBackground": "#52d0b3",
    "badge.background": "#1ed1cd",
    "badge.foreground": "#001218",
    "gitDecoration.modifiedResourceForeground": "#eebb58",
    "gitDecoration.untrackedResourceForeground": "#52d0b3",
    "gitDecoration.deletedResourceForeground": "#ff918b",
    "editorGutter.addedBackground": "#4eca7a",
    "editorGutter.modifiedBackground": "#eebb58",
    "editorGutter.deletedBackground": "#ff918b",
    "scrollbarSlider.background": "#2a303a80",
    "scrollbarSlider.hoverBackground": "#3a425080",
    "dropdown.background": "#1c2027",
    "dropdown.border": "#2a3038",
    "quickInput.background": "#1c2027",
    "quickInput.foreground": "#dfe4ec",
    "menu.background": "#1c2027",
    "menu.foreground": "#dfe4ec",
    "menu.selectionBackground": "#2b3a48",
    "welcomePage.background": "#171b23",
    "welcomePage.tileBackground": "#1c2027",
    "welcomePage.tileBorder": "#2a3038",
    "editorGroup.border": "#2a3038",
    "tab.activeBorderTop": "#7fd3ea",
    "textLink.foreground": "#7fd3ea",
    "descriptionForeground": "#6b7689",
    "icon.foreground": "#97a3b6",
    "sideBarSectionHeader.background": "#1c2027",
    "sideBarSectionHeader.foreground": "#97a3b6",
    "statusBarItem.hoverBackground": "#242a35",
    "toolbar.hoverBackground": "#242a35"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b7689", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#9fdcb0" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#8ad6f0" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#1ed1cd" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#f0c987" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#68e099" }
    }
  ]
}
