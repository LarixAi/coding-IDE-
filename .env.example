# CodeMe local + remote model configuration.
#
# n8n remains local to the Mac/IDE unless you intentionally move it.
CODEME_N8N_URL=http://127.0.0.1:5678
CODEME_N8N_TOKEN=

# Prompt Enhancement gate. CodeMe uses this before a new agent run.
CODEME_N8N_ENHANCE_URL=http://127.0.0.1:5678/webhook/prompt.enrich
CODEME_N8N_AUTO_ENHANCE=true

# n8n's MCP server (Settings -> MCP access). Keep the bearer token only in
# your local .env; never commit it.
CODEME_N8N_MCP_URL=http://127.0.0.1:5678/mcp-server/http
CODEME_N8N_MCP_TOKEN=

# Local Ollama on the Mac.
CODEME_LOCAL_OLLAMA_URL=http://127.0.0.1:11434

# Remote Ollama on codeme-ai over Tailscale.
# codeme-ai Tailscale address: 100.81.117.90
CODEME_SERVER_OLLAMA_URL=http://100.81.117.90:11434

# Backward-compatible default used by non-Composer probes/tests.
CODEME_OLLAMA_URL=http://127.0.0.1:11434

# Paperclip control plane bridge.
# Keep this disabled until Paperclip is installed/configured locally.
CODEME_PAPERCLIP_ENABLED=false
CODEME_PAPERCLIP_PORT=7788
CODEME_PAPERCLIP_BRIDGE_TOKEN=
PAPERCLIP_API_URL=http://127.0.0.1:3100

# Legacy/single-agent controller identity. Multi-agent setup keeps this as the
# controller fallback and adds per-agent identities below.
PAPERCLIP_API_KEY=
PAPERCLIP_CONTROLLER_AGENT_ID=

# Multi-agent routing. Keep the key JSON only in your local .env.
# Example roles JSON:
# {"<controller-id>":"controller","<cto-id>":"cto","<research-id>":"research","<developer-id>":"developer","<test-id>":"test","<reviewer-id>":"reviewer"}
CODEME_PAPERCLIP_AGENT_ROLES_JSON='{}'
CODEME_PAPERCLIP_AGENT_KEYS_JSON='{}'

# When multi-agent roles are configured, controller-assigned tasks are routed
# through CTO -> Developer -> Test -> Reviewer. Set false to fall back to the
# controller's direct single-agent execution path.
CODEME_PAPERCLIP_TEAM_ORCHESTRATION=true

# Used by qualification scripts that need a specific model.
CODEME_QWEN_MODEL=qwen3.5:9b
